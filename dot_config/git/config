[user]
	name = Kevin Diaz
	email = developer@kev314.dev
	signingkey = ~/.ssh/github.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[diff]
	algorithm = histogram
	colorMoved = plain
[branch]
	sort = -committerdate
